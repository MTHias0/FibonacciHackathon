{
  "name": "fibonacci-hackathon",
  "version": "0.1.0",
  "private": true,
  "description": "LawMCP: servidor MCP para consultar, citar e verificar leis de qualquer jurisdição.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "mcp": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/server.js",
    "data:fetch": "node src/scripts/fetch-data.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
